FROM registry.redhat.io/ubi9/python-312:latest

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY deploy/configs/ ./configs/
COPY static/ ./static/

VOLUME /model
VOLUME /input
VOLUME /output

RUN mkdir -p /input /output

EXPOSE 8443

ENTRYPOINT ["python", "-m", "app"]
CMD ["serve"]
